[Unit]
Description=Daily X bookmark image backup at a random Beijing morning time

[Timer]
# Compatible with systemd 249; each day gets a new random start delay.
OnCalendar=*-*-* 03:00:00 Asia/Shanghai
RandomizedDelaySec=10799s
AccuracySec=1s
FixedRandomDelay=no
# Do not replay a missed run outside the permitted start window after boot.
Persistent=false
Unit=pixiv-x-bookmarks.service

[Install]
WantedBy=timers.target
